{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://psupgftxzyoyeyuhtqgw.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "guttahutte",
      "version": "0.3.0",
      "title": "GüttaHütte"
    },
    "tools": [
      {
        "name": "get_active_trip",
        "title": "Aktiv tur",
        "description": "Hent den aktive turen: navn, destinasjon, land, tidssone, valuta og datoer (null hvis ikke satt).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_agenda",
        "title": "Agenda",
        "description": "Hent agendaen (tidslinjen) for den aktive turen, sortert etter starttid.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "upcoming_only": {
              "default": false,
              "description": "Bare hendelser som ikke er ferdige.",
              "type": "boolean"
            },
            "limit": {
              "default": 50,
              "description": "Maks antall hendelser.",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_recent_chat_messages",
        "title": "Nylige chat-meldinger",
        "description": "Hent de siste meldingene i chatten for den aktive turen.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Antall meldinger (1-100).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "post_chat_message",
        "title": "Send chat-melding",
        "description": "Send en melding til chatten for den aktive turen, som den innloggede brukeren.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "Meldingsteksten."
            }
          },
          "required": [
            "text"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_recent_media",
        "title": "Stories og Minner siste døgn",
        "description": "Oversikt (uten filer) over aktive Stories og nye Minner i den aktive turen siste 24 timer.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_my_profile",
        "title": "Hent min profil",
        "description": "Hent den innloggede brukerens GüttaHütte-profil (navn, kallenavn, avatar).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
